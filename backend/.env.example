# Database connection.
# Default is a local SQLite file (no server / no account / works offline).
DATABASE_URL=sqlite:///./mira.db
# For PostgreSQL instead, comment the line above and use e.g.:
# DATABASE_URL=postgresql+psycopg2://mira_user:mira_password@localhost:5432/mira_db
# Neon/Supabase (free cloud): keep the ?sslmode=require they give you, e.g.:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# App/API metadata
API_V1_PREFIX=/api/v1
